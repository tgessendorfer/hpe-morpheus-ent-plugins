<div class="finops-showback">
{{#if hasData}}
  {{#if hasCurrent}}
  {{#each current}}
  <div class="intro-stats">
    <div class="count-stats">
      <div class="stats-container"><span class="big-stat">{{runningText}} {{currency}}</span><span class="stat-label">{{../t.monthToDate}} ({{../t.day}} {{../day}}/{{../days}})</span></div>
      <div class="stats-container"><span class="big-stat">{{forecastText}} {{currency}}</span><span class="stat-label">{{../t.forecast}}</span></div>
      {{#if @first}}<div class="stats-container"><span class="big-stat">{{../plan}}</span><span class="stat-label">{{../t.plan}}</span></div>{{/if}}
    </div>
  </div>
  {{/each}}
  <h3>{{t.splitHeading}}</h3>
  <table class="table table-condensed">
    <thead><tr><th>{{t.currency}}</th><th>{{t.compute}}</th><th>{{t.storage}}</th><th>{{t.licenses}}</th></tr></thead>
    <tbody>
    {{#each current}}<tr><td>{{currency}}</td><td>{{computeText}}</td><td>{{storageText}}</td><td>{{licenseText}}</td></tr>{{/each}}
    </tbody>
  </table>
  {{else}}
  <p>{{t.noCurrent}}</p>
  {{/if}}
  <h3>{{t.history}}</h3>
  <table class="table table-condensed">
    <thead><tr><th style="width:120px">{{t.month}}</th><th style="width:80px">{{t.currency}}</th><th style="width:140px">{{t.amount}}</th><th></th></tr></thead>
    <tbody>
    {{#each history}}
      {{#if has}}
      {{#each amounts}}
      <tr><td>{{#if @first}}{{../month}}{{#if ../current}} *{{/if}}{{/if}}</td><td>{{currency}}</td><td>{{priceText}}</td>
        <td><div class="finops-bar" style="background:#8c96a3;height:10px;width:{{bar}}%;min-width:1px"></div></td></tr>
      {{/each}}
      {{else}}
      <tr><td>{{month}}{{#if current}} *{{/if}}</td><td>-</td><td>-</td><td></td></tr>
      {{/if}}
    {{/each}}
    </tbody>
  </table>
  <p class="text-muted">{{t.footCurrent}} {{t.footPrices}} {{t.footUpdated}} {{updated}} UTC.
  {{#if multiCurrency}}{{t.footMulti}} {{currencies}}. {{t.footMultiRule}}{{/if}}</p>
{{else}}
  <p>{{t.noDataFor}} {{instanceName}}. {{t.noDataHint}}</p>
{{/if}}
</div>
