<div class="intro-stats finops-chargeback">
  <h2>{{t.title}} {{footer.month}}{{#if footer.isCurrent}} ({{t.currentMonth}}){{/if}}</h2>
  <div class="count-stats">
    <div class="stats-container"><span class="big-stat">{{footer.tenants}}</span><span class="stat-label">{{t.tenants}}</span></div>
    {{#each totals}}
    <div class="stats-container"><span class="big-stat">{{invoiceText}} {{currency}}</span><span class="stat-label">{{../t.invoiceTotal}} ({{../t.inclMarkup}} {{../footer.markupPercentText}} %)</span></div>
    {{/each}}
  </div>
</div>
<h3>{{t.section_currency}}</h3>
<table class="table table-condensed finops-table">
  <thead><tr><th>{{t.col_currency}}</th><th>{{t.col_resources}}</th><th>{{t.col_cost}}</th><th>{{t.col_price}}</th><th>{{t.col_margin}}</th><th>{{t.col_marginPct}}</th><th>{{t.col_invoice}}</th></tr></thead>
  <tbody>
  {{#each totals}}
    <tr><td>{{currency}}</td><td>{{resources}}</td><td>{{costText}}</td><td>{{priceText}}</td><td>{{marginText}}</td><td>{{marginPctText}}</td><td><strong>{{invoiceText}}</strong></td></tr>
  {{else}}
    <tr><td colspan="7">{{t.empty}}</td></tr>
  {{/each}}
  </tbody>
</table>
<h3>{{t.section_tenant}}</h3>
<table class="table table-condensed finops-table">
  <thead><tr><th>{{t.col_tenant}}</th><th>{{t.col_currency}}</th><th>{{t.col_resources}}</th><th>{{t.col_cost}}</th><th>{{t.col_price}}</th><th>{{t.col_margin}}</th><th>{{t.col_marginPct}}</th><th>{{t.col_invoice}}</th></tr></thead>
  <tbody>
  {{#each tenants}}
    <tr><td>{{tenant}}</td><td>{{currency}}</td><td>{{resources}}</td><td>{{costText}}</td><td>{{priceText}}</td><td>{{marginText}}</td><td>{{marginPctText}}</td><td><strong>{{invoiceText}}</strong></td></tr>
  {{else}}
    <tr><td colspan="8">{{t.empty}}</td></tr>
  {{/each}}
  </tbody>
</table>
<h3>{{t.section_group}}</h3>
<table class="table table-condensed finops-table">
  <thead><tr><th>{{t.col_tenant}}</th><th>{{t.col_group}}</th><th>{{t.col_currency}}</th><th>{{t.col_resources}}</th><th>{{t.col_cost}}</th><th>{{t.col_price}}</th><th>{{t.col_margin}}</th><th>{{t.col_invoice}}</th></tr></thead>
  <tbody>
  {{#each rows}}
    <tr><td>{{tenant}}</td><td>{{#if noGroup}}<em>{{noGroupText}}</em>{{else}}{{group}}{{/if}}</td><td>{{currency}}</td><td>{{resources}}</td><td>{{costText}}</td><td>{{priceText}}</td><td>{{marginText}}</td><td>{{invoiceText}}</td></tr>
  {{/each}}
  </tbody>
</table>
<p class="text-muted">{{t.footnote}}</p>
