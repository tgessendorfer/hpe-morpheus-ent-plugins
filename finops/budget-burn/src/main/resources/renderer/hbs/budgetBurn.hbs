<div class="finops-budget-burn" lang="{{language}}">
  <style>
    .finops-budget-burn .finops-scroll { overflow-x: auto; }
    .finops-budget-burn table.finops-table { width: 100%; margin-bottom: 12px; }
    .finops-budget-burn .finops-table > thead > tr > th,
    .finops-budget-burn .finops-table > tbody > tr > td { padding: 6px 5px; vertical-align: top; }
    .finops-budget-burn .finops-table > thead > tr > th { font-size: 11px; vertical-align: bottom; }
    .finops-budget-burn .finops-table > thead > tr > th + th { width: 1%; }
    .finops-budget-burn .finops-table > thead > tr > th.num { min-width: 72px; }
    .finops-budget-burn .finops-table .num { text-align: right; }
    .finops-budget-burn .finops-table > tbody > tr > td.num { white-space: nowrap; }
    .finops-budget-burn .finops-name { font-weight: 600; }
    .finops-budget-burn .finops-sub { display: block; font-size: 11px; line-height: 1.35; opacity: .75; }
    .finops-budget-burn .finops-table .num .finops-sub { white-space: nowrap; }
    .finops-budget-burn .finops-table .num .finops-sub.finops-wrap { white-space: normal; }
    .finops-budget-burn .finops-bar-cell { min-width: 150px; }
    .finops-budget-burn .finops-bar-track { height: 10px; margin-top: 4px; border-radius: 2px; background: rgba(128, 128, 128, .25); }
    .finops-budget-burn .finops-bar { height: 10px; min-width: 1px; border-radius: 2px; }
    .finops-budget-burn .finops-status { font-weight: 600; white-space: nowrap; }
  </style>
  <h2>{{text.heading}} {{month}}</h2>
  <p class="text-muted">{{text.day}} {{day}} {{text.dayOf}} {{days}}.
    {{#if master}}{{text.intro.master}}{{else}}{{text.intro.tenant}} {{tenant}}.{{/if}}
    {{text.intro.forecast}}</p>
  <div class="finops-scroll">
  <table class="table table-condensed finops-table">
    <thead><tr>
      <th>{{text.col.budget}}</th>
      <th class="num">{{text.col.monthlyBudget}}</th><th class="num">{{text.col.toDate}}</th>
      <th class="num">{{text.col.burnRate}}</th><th class="num">{{text.col.forecast}}</th>
      <th class="finops-bar-cell">{{text.col.forecastVsBudget}}</th><th>{{text.col.status}}</th>
      <th class="num">{{text.col.yearToDate}}</th>
    </tr></thead>
    <tbody>
    {{#each items}}
      <tr>
        <td><span class="finops-name">{{name}}</span>
          <span class="finops-sub">{{#if ../master}}{{../text.col.owner}}: {{owner}} &middot; {{/if}}{{scopeText}}: {{target}}</span></td>
        <td class="num">{{budgetText}} {{currency}}</td>
        {{#if mismatch}}
        <td class="num">{{runningText}}{{#if foreignRunning}}<span class="finops-sub">+ {{foreignRunning}}</span>{{/if}}</td><td class="num">-</td>
        <td class="num">{{forecastText}}{{#if foreignForecast}}<span class="finops-sub">+ {{foreignForecast}}</span>{{/if}}</td>
        <td class="finops-bar-cell"><span class="finops-sub">{{../text.noComparison}} ({{currency}})</span></td>
        {{else}}
        <td class="num">{{runningText}}<span class="finops-sub">{{usedPct}}</span></td><td class="num">{{burnText}}</td><td class="num">{{forecastText}}</td>
        <td class="finops-bar-cell"><div class="finops-bar-track"><div class="finops-bar" style="background:{{color}};width:{{bar}}%"></div></div><span class="finops-sub">{{forecastPct}}</span></td>
        {{/if}}
        <td><span class="finops-status" style="color:{{color}}">{{statusText}}</span></td>
        {{#if ytdMismatch}}
        <td class="num">{{ytdText}} / {{ytdBudgetText}}<span class="finops-sub finops-wrap">+ {{foreignYtd}}, {{../text.status.mismatch}}</span></td>
        {{else}}
        <td class="num">{{ytdText}} / {{ytdBudgetText}}<span class="finops-sub">{{ytdPct}}</span></td>
        {{/if}}
      </tr>
    {{else}}
      <tr><td colspan="8">{{text.empty}}</td></tr>
    {{/each}}
    </tbody>
  </table>
  </div>
  {{#if anyMismatch}}<p class="text-muted">{{text.mismatchNote}}</p>{{/if}}
</div>
