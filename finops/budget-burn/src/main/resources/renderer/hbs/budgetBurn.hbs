<div class="finops-budget-burn" lang="{{language}}">
  <h2>{{text.heading}} {{month}}</h2>
  <p class="text-muted">{{text.day}} {{day}} {{text.dayOf}} {{days}}.
    {{#if master}}{{text.intro.master}}{{else}}{{text.intro.tenant}} {{tenant}}.{{/if}}
    {{text.intro.forecast}}</p>
  <table class="table table-condensed">
    <thead><tr>
      <th>{{text.col.budget}}</th>{{#if master}}<th>{{text.col.owner}}</th>{{/if}}
      <th>{{text.col.scope}}</th><th>{{text.col.currency}}</th>
      <th>{{text.col.monthlyBudget}}</th><th>{{text.col.toDate}}</th>
      <th>{{text.col.burnRate}}</th><th>{{text.col.forecast}}</th>
      <th style="width:20%">{{text.col.forecastVsBudget}}</th><th>{{text.col.status}}</th>
      <th>{{text.col.yearToDate}}</th>
    </tr></thead>
    <tbody>
    {{#each items}}
      <tr>
        <td>{{name}}</td>{{#if ../master}}<td>{{owner}}</td>{{/if}}<td>{{scopeText}}: {{target}}</td><td>{{currency}}</td>
        <td>{{budgetText}} {{currency}}</td>
        {{#if mismatch}}
        <td>{{runningText}} {{currency}}{{#if foreignRunning}}<br><small>+ {{foreignRunning}}</small>{{/if}}</td><td>-</td>
        <td>{{forecastText}} {{currency}}{{#if foreignForecast}}<br><small>+ {{foreignForecast}}</small>{{/if}}</td>
        <td><small>{{../text.noComparison}} ({{currency}})</small></td>
        {{else}}
        <td>{{runningText}} {{currency}} ({{usedPct}})</td><td>{{burnText}} {{currency}}</td><td>{{forecastText}} {{currency}}</td>
        <td><div class="finops-bar-track" style="background:#e6e6e6;height:12px;width:100%"><div class="finops-bar" style="background:{{color}};height:12px;width:{{bar}}%;min-width:1px"></div></div><small>{{forecastPct}}</small></td>
        {{/if}}
        <td><span class="finops-status" style="color:{{color}};font-weight:600">{{statusText}}</span></td>
        {{#if ytdMismatch}}
        <td>{{ytdText}} / {{ytdBudgetText}} {{currency}}<br><small>+ {{foreignYtd}}, {{../text.status.mismatch}}</small></td>
        {{else}}
        <td>{{ytdText}} / {{ytdBudgetText}} {{currency}} ({{ytdPct}})</td>
        {{/if}}
      </tr>
    {{else}}
      <tr><td colspan="11">{{text.empty}}</td></tr>
    {{/each}}
    </tbody>
  </table>
  {{#if anyMismatch}}<p class="text-muted">{{text.mismatchNote}}</p>{{/if}}
</div>
