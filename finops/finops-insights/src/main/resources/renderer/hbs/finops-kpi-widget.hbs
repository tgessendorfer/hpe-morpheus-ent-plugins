<div class="dashboard-widget finops-insights finops-insights-kpi">
  <style>
    .finops-insights { font-size: 13px; }
    .finops-insights .dashboard-widget-header, .finops-insights .dashboard-widget-header * { text-transform: none; }
    .finops-insights .dashboard-widget-header .fi-title { flex-grow: 1; }
    .finops-insights .dashboard-widget-header .fi-note { font-size: 11px; opacity: .65; text-transform: none; }
    .finops-insights .fi-hint { padding: 14px; border: 1px dashed rgba(128,128,128,.45); border-radius: 8px; opacity: .8; }
    .finops-insights .fi-cards { display: grid; grid-template-columns: repeat(auto-fit, minmax(150px, 1fr)); gap: 10px; }
    .finops-insights .fi-card { position: relative; min-width: 0; padding: 10px 12px 9px 14px; border: 1px solid rgba(128,128,128,.3); border-radius: 8px; overflow: hidden; }
    .finops-insights .fi-card::before { content: ""; position: absolute; left: 0; top: 0; bottom: 0; width: 4px; background: #8a8f98; }
    .finops-insights .fi-card.fi-blue::before { background: #2f80ed; }
    .finops-insights .fi-card.fi-orange::before { background: #f2994a; }
    .finops-insights .fi-card.fi-green::before { background: #27ae60; }
    .finops-insights .fi-card.fi-red::before { background: #eb5757; }
    .finops-insights .fi-value { display: block; font-size: 21px; line-height: 1.15; font-weight: 600; white-space: nowrap; }
    .finops-insights .fi-value small { font-size: 12px; font-weight: 400; opacity: .7; margin-left: 3px; }
    .finops-insights .fi-label { display: block; margin-top: 3px; font-size: 11px; line-height: 1.3; opacity: .75; }
    .finops-insights .fi-sub { display: block; font-size: 11px; line-height: 1.3; opacity: .55; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    .finops-insights .fi-deactivated { margin-top: 6px; font-size: 11px; line-height: 1.3; opacity: .65; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  </style>
  <div class="dashboard-widget-header"><span class="fi-title">{{title}}</span>{{#if otherCurrencies}}<span class="fi-note">{{t.note_otherCurrencies}} {{otherCurrencies}}</span>{{/if}}</div>
  <div class="dashboard-widget-body">
    <div class="dashboard-widget-content top-space">
      {{#if ok}}
      <div class="fi-cards">
        {{#each cards}}
        <div class="fi-card fi-{{accent}}">
          <span class="fi-value">{{value}}{{#if unit}}<small>{{unit}}</small>{{/if}}</span>
          <span class="fi-label">{{label}}</span>
          <span class="fi-sub">{{sub}}</span>
        </div>
        {{/each}}
      </div>
      {{#if deactivatedLine}}<div class="fi-deactivated" title="{{deactivatedLine}}">{{deactivatedLine}}</div>{{/if}}
      {{else}}
      <div class="fi-hint">{{hint}}</div>
      {{/if}}
    </div>
  </div>
</div>
