<div class="finops-msp-tenant-overview">
  <h2>{{t.title}} {{month}}</h2>
  <div class="intro-stats">
    <div class="count-stats">
      <div class="stats-container"><span class="big-stat">{{count}}</span><span class="stat-label">{{t.tenants}}</span></div>
      <div class="stats-container"><span class="big-stat">{{instances}}</span><span class="stat-label">{{t.instances}} ({{cores}} {{t.vcpu}})</span></div>
      {{#each totals}}
      <div class="stats-container"><span class="big-stat">{{revText}}</span><span class="stat-label">{{../t.revenue}} {{../month}} ({{../t.forecast}}, {{currency}})</span></div>
      <div class="stats-container"><span class="big-stat">{{marginText}}</span><span class="stat-label">{{../t.margin}} {{../month}} ({{currency}}{{#if marginPctLabel}}, {{marginPctLabel}}{{/if}})</span></div>
      <div class="stats-container"><span class="big-stat">{{lrevText}}</span><span class="stat-label">{{../t.revenue}} {{../lastMonth}} ({{currency}}, {{../t.margin}} {{lmarginText}})</span></div>
      {{/each}}
    </div>
  </div>
  <table class="table table-condensed">
    <thead><tr>
      <th>{{t.col_tenant}}</th><th>{{t.col_users}}</th>
      <th>{{t.col_groups}}</th><th>{{t.instances}}</th>
      <th>{{t.vcpu}}</th><th>{{t.col_memoryGb}}</th>
      <th>{{t.col_servers}}</th><th>{{t.col_currency}}</th>
      <th>{{t.revenue}} {{month}}</th><th>{{t.col_cost}}</th>
      <th>{{t.margin}}</th><th>{{t.col_marginPct}}</th>
      <th>{{t.revenue}} {{lastMonth}}</th><th>{{t.margin}} {{lastMonth}}</th>
    </tr></thead>
    <tbody>
    {{#each items}}
      <tr>{{#if first}}<td><strong>{{name}}</strong></td><td>{{users}}</td><td>{{sites}}</td><td>{{instances}}</td><td>{{cores}}</td><td>{{memoryGb}}</td><td>{{servers}}</td>{{else}}<td colspan="7"></td>{{/if}}
        <td>{{currency}}</td><td>{{revText}}</td><td>{{costText}}</td><td>{{marginText}}</td><td>{{marginPct}}</td><td>{{lrevText}}</td><td>{{lmarginText}}{{#if lmarginPctLabel}} ({{lmarginPctLabel}}){{/if}}</td></tr>
    {{else}}
      <tr><td colspan="14">{{t.noTenants}}</td></tr>
    {{/each}}
    </tbody>
    {{#if totals}}
    <tfoot>
    {{#each totals}}
      <tr><td colspan="7"><strong>{{../t.total}} {{currency}}</strong></td><td>{{currency}}</td><td><strong>{{revText}}</strong></td><td>{{costText}}</td><td>{{marginText}}</td><td>{{marginPct}}</td><td>{{lrevText}}</td><td>{{lmarginText}}{{#if lmarginPctLabel}} ({{lmarginPctLabel}}){{/if}}</td></tr>
    {{/each}}
    </tfoot>
    {{/if}}
  </table>
  <p class="text-muted">{{t.footnote}}</p>
</div>
