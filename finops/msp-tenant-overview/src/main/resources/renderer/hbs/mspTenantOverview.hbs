<div class="finops-msp-tenant-overview">
  <style>
    .finops-msp-tenant-overview .finops-kpis { display: grid; grid-template-columns: repeat(auto-fit, minmax(140px, 1fr)); gap: 12px; margin: 0 0 16px; }
    .finops-msp-tenant-overview .finops-kpi { min-width: 0; padding: 10px 14px; border: 1px solid rgba(128, 128, 128, .35); border-radius: 6px; }
    .finops-msp-tenant-overview .finops-kpi-value { display: block; font-size: 22px; line-height: 1.2; font-weight: 600; white-space: nowrap; }
    .finops-msp-tenant-overview .finops-kpi-label { display: block; margin-top: 4px; font-size: 12px; line-height: 1.3; opacity: .75; }
    .finops-msp-tenant-overview .finops-scroll { overflow-x: auto; }
    .finops-msp-tenant-overview table.finops-table { width: 100%; margin-bottom: 12px; }
    .finops-msp-tenant-overview .finops-table > thead > tr > th,
    .finops-msp-tenant-overview .finops-table > tbody > tr > td,
    .finops-msp-tenant-overview .finops-table > tfoot > tr > td { padding: 5px 5px; white-space: nowrap; vertical-align: top; }
    .finops-msp-tenant-overview .finops-table > thead > tr > th { font-size: 11px; white-space: normal; vertical-align: bottom; }
    .finops-msp-tenant-overview .finops-table > thead > tr > th.finops-group { text-align: center; border-bottom: 1px solid rgba(128, 128, 128, .35); }
    .finops-msp-tenant-overview .finops-table .num { text-align: right; }
    .finops-msp-tenant-overview .finops-sub { display: block; font-size: 11px; line-height: 1.35; opacity: .75; }
  </style>
  <h2>{{t.title}} {{month}}</h2>
  <div class="finops-kpis">
    <div class="finops-kpi"><span class="finops-kpi-value">{{count}}</span><span class="finops-kpi-label">{{t.tenants}}</span></div>
    <div class="finops-kpi"><span class="finops-kpi-value">{{instances}}</span><span class="finops-kpi-label">{{t.instances}} ({{cores}} {{t.vcpu}})</span></div>
    {{#each totals}}
    <div class="finops-kpi"><span class="finops-kpi-value">{{revText}}</span><span class="finops-kpi-label">{{../t.revenue}} {{../month}} ({{../t.forecast}}, {{currency}})</span></div>
    <div class="finops-kpi"><span class="finops-kpi-value">{{marginText}}</span><span class="finops-kpi-label">{{../t.margin}} {{../month}} ({{currency}}{{#if marginPctLabel}}, {{marginPctLabel}}{{/if}})</span></div>
    <div class="finops-kpi"><span class="finops-kpi-value">{{lrevText}}</span><span class="finops-kpi-label">{{../t.revenue}} {{../lastMonth}} ({{currency}}, {{../t.margin}} {{lmarginText}})</span></div>
    {{/each}}
  </div>
  <div class="finops-scroll">
  <table class="table table-condensed finops-table">
    <thead>
    <tr>
      <th rowspan="2">{{t.col_tenant}}</th><th rowspan="2" class="num">{{t.col_users}}</th>
      <th rowspan="2" class="num">{{t.col_groups}}</th><th rowspan="2" class="num">{{t.instances}}</th>
      <th rowspan="2" class="num">{{t.vcpu}}</th><th rowspan="2" class="num">{{t.col_memoryGb}}</th>
      <th rowspan="2" class="num">{{t.col_servers}}</th><th rowspan="2">{{t.col_currency}}</th>
      <th colspan="3" class="finops-group">{{month}} ({{t.forecast}})</th><th colspan="2" class="finops-group">{{lastMonth}}</th>
    </tr>
    <tr>
      <th class="num">{{t.revenue}}</th><th class="num">{{t.col_cost}}</th><th class="num">{{t.margin}}</th>
      <th class="num">{{t.revenue}}</th><th class="num">{{t.margin}}</th>
    </tr>
    </thead>
    <tbody>
    {{#each items}}
      <tr>{{#if first}}<td><strong>{{name}}</strong></td><td class="num">{{users}}</td><td class="num">{{sites}}</td><td class="num">{{instances}}</td><td class="num">{{cores}}</td><td class="num">{{memoryGb}}</td><td class="num">{{servers}}</td>{{else}}<td colspan="7"></td>{{/if}}
        <td>{{currency}}</td><td class="num">{{revText}}</td><td class="num">{{costText}}</td><td class="num">{{marginText}}{{#if marginPctLabel}}<span class="finops-sub">{{marginPctLabel}}</span>{{/if}}</td><td class="num">{{lrevText}}</td><td class="num">{{lmarginText}}{{#if lmarginPctLabel}}<span class="finops-sub">{{lmarginPctLabel}}</span>{{/if}}</td></tr>
    {{else}}
      <tr><td colspan="13">{{t.noTenants}}</td></tr>
    {{/each}}
    </tbody>
    {{#if totals}}
    <tfoot>
    {{#each totals}}
      <tr><td colspan="7"><strong>{{../t.total}} {{currency}}</strong></td><td>{{currency}}</td><td class="num"><strong>{{revText}}</strong></td><td class="num">{{costText}}</td><td class="num">{{marginText}}{{#if marginPctLabel}}<span class="finops-sub">{{marginPctLabel}}</span>{{/if}}</td><td class="num">{{lrevText}}</td><td class="num">{{lmarginText}}{{#if lmarginPctLabel}}<span class="finops-sub">{{lmarginPctLabel}}</span>{{/if}}</td></tr>
    {{/each}}
    </tfoot>
    {{/if}}
  </table>
  </div>
  <p class="text-muted">{{t.footnote}}</p>
</div>
