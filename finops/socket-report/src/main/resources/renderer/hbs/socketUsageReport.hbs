<div class="finops-socket-usage-report">
<div class="intro-stats">
  <h2>{{text.title}}</h2>
  <div class="count-stats">
    <div class="stats-container"><span class="big-stat">{{footer.sockets}}</span><span class="stat-label">{{text.stat.total}}</span></div>
    <div class="stats-container"><span class="big-stat">{{footer.hostSockets}}</span><span class="stat-label">{{text.stat.hostSockets}} ({{footer.hosts}} {{text.stat.hosts}})</span></div>
    <div class="stats-container"><span class="big-stat">{{footer.vmSockets}}</span><span class="stat-label">{{text.stat.vmSockets}} ({{footer.vmsWithoutHost}} {{text.stat.vmsWithoutHost}} / {{footer.vmsPerSocket}})</span></div>
  </div>
</div>
<h3>{{text.section.perTenant}}</h3>
<table class="table table-condensed">
  <thead><tr><th>{{text.column.tenant}}</th><th>{{text.column.hosts}}</th><th>{{text.column.hostSockets}}</th><th>{{text.column.vmsWithoutHost}}</th><th>{{text.column.vmSockets}}</th><th>{{text.column.sockets}}</th></tr></thead>
  <tbody>
  {{#each tenants}}<tr><td>{{tenant}}</td><td>{{hosts}}</td><td>{{hostSockets}}</td><td>{{vmsWithoutHost}}</td><td>{{vmSockets}}</td><td><strong>{{sockets}}</strong></td></tr>{{/each}}
  </tbody>
</table>
<h3>{{text.section.perCloud}}</h3>
<table class="table table-condensed">
  <thead><tr><th>{{text.column.cloud}}</th><th>{{text.column.type}}</th><th>{{text.column.tenant}}</th><th>{{text.column.hosts}}</th><th>{{text.column.hostSockets}}</th><th>{{text.column.hostsDefault}} {{footer.defaultHostSockets}}</th><th>{{text.column.vmsOnHosts}}</th><th>{{text.column.vmsWithoutHost}}</th><th>{{text.column.vmSockets}}</th><th>{{text.column.sockets}}</th></tr></thead>
  <tbody>
  {{#each rows}}<tr><td>{{cloud}}</td><td>{{cloudType}}{{#if category}} ({{category}}){{/if}}</td><td>{{tenant}}</td><td>{{hosts}}</td><td>{{hostSockets}}</td><td>{{hostsDefault}}</td><td>{{vmsOnHosts}}</td><td>{{vmsWithoutHost}}</td><td>{{vmSockets}}</td><td><strong>{{sockets}}</strong></td></tr>{{/each}}
  </tbody>
</table>
<p class="text-muted">{{text.note.rule}} {{text.note.vmsPerSocket}} {{footer.vmsPerSocket}}. {{text.note.defaultHostSockets}} {{footer.defaultHostSockets}}. {{text.note.authoritative}}</p>
</div>
