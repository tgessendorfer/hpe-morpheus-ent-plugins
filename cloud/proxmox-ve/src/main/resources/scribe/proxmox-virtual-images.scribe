// System-provided virtual images for the Proxmox VE cloud: the qcow2 images HPE builds for
// Morpheus, with cloud-init and the agent prerequisites baked in. They appear under
// Library > Virtual Images (filter "System") and in the provisioning wizard's Image list.
// On the first provision the plugin downloads the image on the node into
// /var/lib/vz/template/qemu and creates a template from it; later provisions clone that
// template. Only images with an HTTP 200 on 2026-09-21 are listed; sizes are 0.8 to 1.5 GB.

resource "virtual-image" "proxmox-image-morpheus-debian-12-20260203" {
  code         = "proxmox.image.morpheus.debian.12.20260203"
  category     = "proxmox.image.morpheus.debian"
  name         = "Morpheus Debian 12 20260203"
  imageType    = "qcow2"
  remotePath   = "https://morpheus-images.s3.amazonaws.com/qemu/20260203/debian-12/morpheus-debian-12-amd64-20260203.qcow2"
  imagePath    = "qemu/20260203/debian-12"
  isCloudInit  = true
  systemImage  = true
  installAgent = true
  osType {
    code  = "debian.12.64"
    owner = null
  }
  zoneType = "proxmox-ve.cloud"
}

resource "os-type-image" "proxmox-image-morpheus-debian-12" {
  code          = "proxmox.image.morpheus.debian.12"
  provisionType = "proxmox-provision-provider"
  virtualImage  = virtual-image.proxmox-image-morpheus-debian-12-20260203
  account       = null
  osType = {
    code  = "debian.12.64"
    owner = null
  }
}

